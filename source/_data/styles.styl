                0 2px 8px rgba(0, 0, 0, 0.3) !important

  .gt-header-textarea::before,
  .gt-header-preview::before
    content: '' !important
    position: absolute !important
    top: 0 !important
    left: 0 !important
    right: 0 !important
    height: 60% !important
    background: linear-gradient(180deg,
                rgba(255, 255, 255, 0.1) 0%,
                rgba(255, 255, 255, 0.05) 50%,
                rgba(255, 255, 255, 0) 100%) !important
    border-radius: 12px 12px 0 0 !important
    pointer-events: none !important
    z-index: 1 !important

  .gt-header-textarea::after,
  .gt-header-preview::after
    content: '' !important
    position: absolute !important
    bottom: 0 !important
    left: 0 !important
    right: 0 !important
    height: 40% !important
    background: linear-gradient(0deg,
                rgba(0, 0, 0, 0.15) 0%,
                rgba(0, 0, 0, 0) 100%) !important
    border-radius: 0 0 12px 12px !important
    pointer-events: none !important
    z-index: 1 !important

  .gt-header-textarea textarea,
  .gt-header-preview textarea
